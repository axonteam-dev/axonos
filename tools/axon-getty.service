[Unit]
Description=AxonOS console login
DefaultDependencies=no
After=systemd-remount-fs.service systemd-tmpfiles-setup.service systemd-sysusers.service axon-network-online.service

[Service]
Type=simple
ExecStart=/bin/busybox getty -L 38400 tty1
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
